.DS_Store
*.xcodeproj/xcuserdata/
# Any derived-data directory, not just the two the scripts use by default.
# A one-off build directory once got staged with five full SwiftPM checkouts
# inside it, which filled the disk mid-commit.
.build*/
DerivedData/
Fixtures/*.mov
Fixtures/*.zip
Fixtures/master/
Fixtures/*.mp4
Fixtures/*.mkv
Fixtures/*.webm
nohup.out
